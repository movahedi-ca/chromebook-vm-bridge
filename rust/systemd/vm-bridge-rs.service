[Unit]
Description=vm-bridge 2.0 (Rust) — browser automation bridge
Documentation=https://github.com/movahedi-ca/chromebook-vm-bridge
After=vnc.service network-online.target
Wants=vnc.service network-online.target

[Service]
Type=notify
# NotifyAccess: we use sd_notify for READY=1 and WATCHDOG=1
NotifyAccess=main
# Watchdog: 60s. Our probe loop notifies every ~13s, well under.
WatchdogSec=60
Restart=on-failure
RestartSec=5
# Cap restart storms
StartLimitIntervalSec=300
StartLimitBurst=3

# Environment: API keys via EnvironmentFile (mode 600), never in the unit.
# BRIDGE_API_KEY in that file is accepted for all scopes (drop-in
# replacement for existing clients). Set VM_BRIDGE_KEYS__READ/ACT/ADMIN
# for real scope separation.
EnvironmentFile=-%h/.config/vm-bridge/env
# Production: live port and the dedicated automation profile (sessions persist
# here; seeded once from the chrome-main copy). The bridge spawns and
# supervises its own Chrome child — no external browser required.
# VM_BRIDGE_BIND_ADDR is pinned to loopback (audit 42 Medium-7): the
# bridge speaks plain HTTP with bearer-token auth, so a non-loopback
# bind is refused at startup unless VM_BRIDGE_ALLOW_NON_LOOPBACK=1.
Environment=VM_BRIDGE_BIND_ADDR=127.0.0.1
Environment=VM_BRIDGE_BIND_PORT=8899
Environment=VM_BRIDGE_PROFILE_DIR=%h/.config/chrome-automation
Environment=DISPLAY=:1
# Default log level: info so the supervisor's spawn/death/relaunch lines are
# visible in the journal without needing RUST_LOG overrides.
Environment=RUST_LOG=info

ExecStart=%h/jobs/vm-bridge-rs/rust/target/release/vm-bridge
WorkingDirectory=%h/jobs/vm-bridge-rs

# Resource limits
MemoryMax=4G
MemoryHigh=3G

# Security hardening (best-effort on user units)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/vm-bridge %h/.config/chrome-automation %h/jobs/vm-bridge-rs %h/jobs/vm-bridge %h/jobs/uploads
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vm-bridge-rs

[Install]
WantedBy=default.target
